{
  "name": "amifidele",
  "version": "0.1.0",
  "description": "Comparateur de produits pour animaux de compagnie",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "cd ../api-amifidele && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\" --names \"WEB,API\" --prefix-colors \"blue,green\"",
    "dev:all:script": "node scripts/dev-all.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "smoke:domaine": "node scripts/smoke-domaine.mjs",
    "wait:dns": "node scripts/wait-dns.mjs"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.11.1",
    "@radix-ui/themes": "^3.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "react-resizable-panels": "^4.12.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
