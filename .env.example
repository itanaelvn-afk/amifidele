# URL upstream api-amifidele (serveur uniquement)
# Dev :
API_URL=http://localhost:4000/api
# Prod Vercel :
# API_URL=https://api.amifidele.fr/api

# Token = API_TOKEN_AUTH de api-amifidele (serveur uniquement — jamais NEXT_PUBLIC_)
API_TOKEN=votre_token_ici

# Origine publique (sitemap.xml, robots.txt, metadataBase). Sans slash final.
# Dev :
SITE_URL=http://localhost:3000
# Prod :
# SITE_URL=https://amifidele.fr

# Formulaire de contact (Formspree) — ID du formulaire, ex. xyzabcde
# Sans cette variable : en dev l’envoi est simulé ; en prod → message d’erreur.
# FORMSPREE_FORM_ID=

# Domaine prod : docs/DEPLOY_VERCEL.md (+ mémo local docs/DOMAINE.local.md si présent)
